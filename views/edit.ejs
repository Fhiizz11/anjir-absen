<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Laporan - Laporan Harian Guru</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .header {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            color: white;
            padding: 2rem 0;
            margin-bottom: 2rem;
            border-radius: 0 0 20px 20px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        .card {
            border-radius: 15px;
            border: none;
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
            margin-bottom: 20px;
            transition: transform 0.3s;
        }
        .card:hover {
            transform: translateY(-5px);
        }
        .card-header {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            color: white;
            border-radius: 15px 15px 0 0 !important;
            padding: 1rem 1.5rem;
            font-weight: 600;
        }
        .btn-primary {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            border: none;
            padding: 10px 30px;
            border-radius: 25px;
            font-weight: 600;
        }
        .btn-primary:hover {
            background: linear-gradient(135deg, #e082ea 0%, #e4465b 100%);
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        }
        .form-control, .form-select {
            border-radius: 10px;
            border: 2px solid #e0e0e0;
            padding: 10px 15px;
        }
        .form-control:focus, .form-select:focus {
            border-color: #f5576c;
            box-shadow: 0 0 0 0.25rem rgba(245, 87, 108, 0.25);
        }
        .table th {
            background-color: #f8f9fa;
            font-weight: 600;
            color: #495057;
        }
        .nav-link {
            color: #495057;
            font-weight: 500;
            padding: 10px 20px;
            border-radius: 10px;
            margin: 0 5px;
        }
        .nav-link:hover, .nav-link.active {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            color: white;
        }
        .info-box {
            background: white;
            padding: 20px;
            border-radius: 15px;
            margin-bottom: 20px;
            border-left: 5px solid #f5576c;
        }
        .jadwal-row {
            margin-bottom: 15px;
            padding: 15px;
            background: #f8f9fa;
            border-radius: 10px;
        }
    </style>
</head>
<body>
    <div class="header text-center">
        <div class="container">
            <h1><i class="bi bi-pencil-square me-2"></i>EDIT LAPORAN HARIAN</h1>
            <p class="lead">Perbarui Laporan Mengajar Harian</p>
        </div>
    </div>

    <div class="container">
        <nav class="nav nav-pills justify-content-center mb-4">
            <a class="nav-link" href="/"><i class="bi bi-house-door me-2"></i>Form Laporan</a>
            <a class="nav-link" href="/siswa"><i class="bi bi-people me-2"></i>Data Siswa</a>
            <a class="nav-link active" href="/rekap"><i class="bi bi-folder me-2"></i>Rekap Laporan</a>
        </nav>

        <div class="info-box">
            <div class="row">
                <div class="col-md-10">
                    <h4>Informasi Laporan</h4>
                    <div class="row mt-3">
                        <div class="col-md-3">
                            <strong>Tanggal:</strong><br>
                            <span class="text-muted"><%= laporan.tanggal %></span>
                        </div>
                        <div class="col-md-3">
                            <strong>Kelas:</strong><br>
                            <span class="text-muted"><%= laporan.kelas %></span>
                        </div>
                        <div class="col-md-3">
                            <strong>Mata Pelajaran:</strong><br>
                            <span class="text-muted"><%= laporan.mataPelajaran %></span>
                        </div>
                        <div class="col-md-3">
                            <strong>Guru:</strong><br>
                            <span class="text-muted"><%= guru %></span>
                        </div>
                    </div>
                </div>
                <div class="col-md-2 text-end">
                    <a href="/rekap" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-2"></i>Kembali
                    </a>
                </div>
            </div>
        </div>

        <form id="editLaporanForm" action="/rekap/update/<%= laporanId %>" method="POST">
            <!-- Bagian 1: Jadwal dan Materi -->
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-calendar3 me-2"></i>1. Jadwal dan Materi Pembelajaran
                </div>
                <div class="card-body">
                    <div id="jadwalContainer">
                        <% if (laporan.jadwal && laporan.jadwal.length > 0) { %>
                            <% laporan.jadwal.forEach((item, index) => { %>
                            <div class="jadwal-row">
                                <div class="row g-3">
                                    <div class="col-md-2">
                                        <label>Jam Ke</label>
                                        <input type="text" class="form-control" name="jamKe[]" value="<%= item.jamKe %>">
                                    </div>
                                    <div class="col-md-2">
                                        <label>Kelas</label>
                                        <input type="text" class="form-control" value="<%= laporan.kelas %>" readonly>
                                    </div>
                                    <div class="col-md-3">
                                        <label>Materi / Topik</label>
                                        <input type="text" class="form-control" name="materi[]" value="<%= item.materi %>">
                                    </div>
                                    <div class="col-md-2">
                                        <label>Metode</label>
                                        <input type="text" class="form-control" name="metode[]" value="<%= item.metode %>">
                                    </div>
                                    <div class="col-md-2">
                                        <label>Media / Alat</label>
                                        <input type="text" class="form-control" name="media[]" value="<%= item.media %>">
                                    </div>
                                    <div class="col-md-1">
                                        <label>Catatan</label>
                                        <input type="text" class="form-control" name="catatanJadwal[]" value="<%= item.catatan %>">
                                    </div>
                                </div>
                            </div>
                            <% }); %>
                        <% } else { %>
                            <div class="jadwal-row">
                                <div class="row g-3">
                                    <div class="col-md-2">
                                        <label>Jam Ke</label>
                                        <input type="text" class="form-control" name="jamKe[]" placeholder="1-2">
                                    </div>
                                    <div class="col-md-2">
                                        <label>Kelas</label>
                                        <input type="text" class="form-control" value="<%= laporan.kelas %>" readonly>
                                    </div>
                                    <div class="col-md-3">
                                        <label>Materi / Topik</label>
                                        <input type="text" class="form-control" name="materi[]" placeholder="Materi pembelajaran">
                                    </div>
                                    <div class="col-md-2">
                                        <label>Metode</label>
                                        <input type="text" class="form-control" name="metode[]" placeholder="Metode">
                                    </div>
                                    <div class="col-md-2">
                                        <label>Media / Alat</label>
                                        <input type="text" class="form-control" name="media[]" placeholder="Media">
                                    </div>
                                    <div class="col-md-1">
                                        <label>Catatan</label>
                                        <input type="text" class="form-control" name="catatanJadwal[]" placeholder="Catatan">
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                    <button type="button" class="btn btn-outline-primary btn-sm mt-2" onclick="tambahJadwal()">
                        <i class="bi bi-plus-circle"></i> Tambah Jam
                    </button>
                </div>
            </div>

            <!-- Bagian 2: Kehadiran Siswa -->
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-person-check me-2"></i>2. Kehadiran & Partisipasi Siswa
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th width="5%">No</th>
                                    <th width="30%">Nama Siswa</th>
                                    <th width="15%">Kehadiran (H/I/S)</th>
                                    <th width="20%">Partisipasi (Aktif/Pasif)</th>
                                    <th width="30%">Catatan</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% kehadiranDenganSiswa.forEach((item, index) => { %>
                                <tr>
                                    <td><%= index + 1 %></td>
                                    <td>
                                        <input type="hidden" name="siswaId[]" value="<%= item.siswaId %>">
                                        <input type="hidden" name="siswaNama[]" value="<%= item.siswaNama %>">
                                        <%= item.siswaNama %>
                                    </td>
                                    <td>
                                        <select class="form-select" name="kehadiran[]">
                                            <option value="H" <%= item.status === 'H' ? 'selected' : '' %>>H (Hadir)</option>
                                            <option value="I" <%= item.status === 'I' ? 'selected' : '' %>>I (Izin)</option>
                                            <option value="S" <%= item.status === 'S' ? 'selected' : '' %>>S (Sakit)</option>
                                        </select>
                                    </td>
                                    <td>
                                        <select class="form-select" name="partisipasi[]">
                                            <option value="Aktif" <%= item.partisipasi === 'Aktif' ? 'selected' : '' %>>Aktif</option>
                                            <option value="Pasif" <%= item.partisipasi === 'Pasif' ? 'selected' : '' %>>Pasif</option>
                                        </select>
                                    </td>
                                    <td>
                                        <input type="text" class="form-control" name="catatanSiswa[]" value="<%= item.catatan %>" placeholder="Catatan">
                                    </td>
                                </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Bagian 3: Kendala -->
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-exclamation-triangle me-2"></i>3. Kendala / Masalah dalam Pembelajaran
                </div>
                <div class="card-body">
                    <textarea class="form-control" name="kendala" rows="3" placeholder="Masukkan kendala atau masalah yang dihadapi..."><%= laporan.kendala || '' %></textarea>
                </div>
            </div>

            <!-- Bagian 4: Tindak Lanjut -->
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-arrow-repeat me-2"></i>4. Tindak Lanjut / Remedial / Pengayaan
                </div>
                <div class="card-body">
                    <div id="tindakLanjutContainer">
                        <% if (laporan.tindakLanjut && laporan.tindakLanjut.length > 0) { %>
                            <% laporan.tindakLanjut.forEach((item, index) => { %>
                            <div class="jadwal-row">
                                <div class="row g-3">
                                    <div class="col-md-3">
                                        <label>Siswa / Kelompok</label>
                                        <input type="text" class="form-control" name="tlSiswa[]" value="<%= item.siswa %>">
                                    </div>
                                    <div class="col-md-3">
                                        <label>Jenis Tindak Lanjut</label>
                                        <select class="form-select" name="tlJenis[]">
                                            <option value="">Pilih jenis...</option>
                                            <option value="Remedial" <%= item.jenis === 'Remedial' ? 'selected' : '' %>>Remedial</option>
                                            <option value="Pengayaan" <%= item.jenis === 'Pengayaan' ? 'selected' : '' %>>Pengayaan</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label>Waktu Pelaksanaan</label>
                                        <input type="text" class="form-control" name="tlWaktu[]" value="<%= item.waktu %>">
                                    </div>
                                    <div class="col-md-3">
                                        <label>Catatan Guru</label>
                                        <input type="text" class="form-control" name="tlCatatan[]" value="<%= item.catatan %>">
                                    </div>
                                </div>
                            </div>
                            <% }); %>
                        <% } else { %>
                            <div class="jadwal-row">
                                <div class="row g-3">
                                    <div class="col-md-3">
                                        <label>Siswa / Kelompok</label>
                                        <input type="text" class="form-control" name="tlSiswa[]" placeholder="Nama siswa/kelompok">
                                    </div>
                                    <div class="col-md-3">
                                        <label>Jenis Tindak Lanjut</label>
                                        <select class="form-select" name="tlJenis[]">
                                            <option value="" selected>Pilih jenis...</option>
                                            <option value="Remedial">Remedial</option>
                                            <option value="Pengayaan">Pengayaan</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label>Waktu Pelaksanaan</label>
                                        <input type="text" class="form-control" name="tlWaktu[]" placeholder="Waktu pelaksanaan">
                                    </div>
                                    <div class="col-md-3">
                                        <label>Catatan Guru</label>
                                        <input type="text" class="form-control" name="tlCatatan[]" placeholder="Catatan guru">
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                    <button type="button" class="btn btn-outline-primary btn-sm mt-2" onclick="tambahTindakLanjut()">
                        <i class="bi bi-plus-circle"></i> Tambah Tindak Lanjut
                    </button>
                </div>
            </div>

            <!-- Bagian 5: Catatan Tambahan -->
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-chat-text me-2"></i>5. Catatan Tambahan
                </div>
                <div class="card-body">
                    <textarea class="form-control" name="catatanTambahan" rows="3" placeholder="Masukkan catatan tambahan..."><%= laporan.catatanTambahan || '' %></textarea>
                </div>
            </div>

            <!-- Tombol Submit -->
            <div class="text-center mt-4 mb-5">
                <button type="submit" class="btn btn-primary btn-lg me-3">
                    <i class="bi bi-save me-2"></i>Simpan Perubahan
                </button>
                <a href="/rekap" class="btn btn-outline-secondary btn-lg">
                    <i class="bi bi-x-circle me-2"></i>Batal
                </a>
            </div>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Tambah baris jadwal
        function tambahJadwal() {
            const container = document.getElementById('jadwalContainer');
            const newRow = document.createElement('div');
            newRow.className = 'jadwal-row mt-3';
            newRow.innerHTML = `
                <div class="row g-3">
                    <div class="col-md-2">
                        <input type="text" class="form-control" name="jamKe[]" placeholder="1-2">
                    </div>
                    <div class="col-md-2">
                        <input type="text" class="form-control" value="<%= laporan.kelas %>" readonly>
                    </div>
                    <div class="col-md-3">
                        <input type="text" class="form-control" name="materi[]" placeholder="Materi pembelajaran">
                    </div>
                    <div class="col-md-2">
                        <input type="text" class="form-control" name="metode[]" placeholder="Metode">
                    </div>
                    <div class="col-md-2">
                        <input type="text" class="form-control" name="media[]" placeholder="Media">
                    </div>
                    <div class="col-md-1">
                        <input type="text" class="form-control" name="catatanJadwal[]" placeholder="Catatan">
                    </div>
                </div>
            `;
            container.appendChild(newRow);
        }

        // Tambah baris tindak lanjut
        function tambahTindakLanjut() {
            const container = document.getElementById('tindakLanjutContainer');
            const newRow = document.createElement('div');
            newRow.className = 'jadwal-row mt-3';
            newRow.innerHTML = `
                <div class="row g-3">
                    <div class="col-md-3">
                        <input type="text" class="form-control" name="tlSiswa[]" placeholder="Nama siswa/kelompok">
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" name="tlJenis[]">
                            <option value="" selected>Pilih jenis...</option>
                            <option value="Remedial">Remedial</option>
                            <option value="Pengayaan">Pengayaan</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <input type="text" class="form-control" name="tlWaktu[]" placeholder="Waktu pelaksanaan">
                    </div>
                    <div class="col-md-3">
                        <input type="text" class="form-control" name="tlCatatan[]" placeholder="Catatan guru">
                    </div>
                </div>
            `;
            container.appendChild(newRow);
        }
    </script>
</body>
</html>