<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rekap Laporan - Laporan Harian Guru</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .header {
            background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
            color: white;
            padding: 2rem 0;
            margin-bottom: 2rem;
            border-radius: 0 0 20px 20px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        .card {
            border-radius: 15px;
            border: none;
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
            margin-bottom: 20px;
            transition: transform 0.3s;
        }
        .card:hover {
            transform: translateY(-5px);
        }
        .nav-link {
            color: #495057;
            font-weight: 500;
            padding: 10px 20px;
            border-radius: 10px;
            margin: 0 5px;
        }
        .nav-link:hover, .nav-link.active {
            background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
            color: white;
        }
        .badge {
            padding: 8px 12px;
            border-radius: 20px;
            font-weight: 500;
        }
        .laporan-card {
            border-left: 5px solid #43e97b;
            padding: 20px;
            margin-bottom: 15px;
            background: white;
            border-radius: 10px;
            transition: all 0.3s;
        }
        .laporan-card:hover {
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }
        .btn-group-sm .btn {
            border-radius: 10px;
            margin: 0 2px;
        }
        .btn-edit {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            border: none;
            color: white;
        }
        .btn-ekspor {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            color: white;
        }
        .btn-hapus {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            border: none;
            color: white;
        }
        .stat-card {
            text-align: center;
            padding: 20px;
            border-radius: 15px;
            color: white;
            margin-bottom: 20px;
        }
        .stat-card-1 {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
        .stat-card-2 {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        }
        .stat-card-3 {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        }
        .stat-number {
            font-size: 2.5rem;
            font-weight: bold;
        }
        .stat-label {
            font-size: 0.9rem;
            opacity: 0.9;
        }
    </style>
</head>
<body>
    <div class="header text-center">
        <div class="container">
            <h1><i class="bi bi-folder me-2"></i>REKAP LAPORAN HARIAN</h1>
            <p class="lead">Arsip dan Manajemen Laporan Mengajar</p>
        </div>
    </div>

    <div class="container">
        <nav class="nav nav-pills justify-content-center mb-4">
            <a class="nav-link" href="/"><i class="bi bi-house-door me-2"></i>Form Laporan</a>
            <a class="nav-link" href="/siswa"><i class="bi bi-people me-2"></i>Data Siswa</a>
            <a class="nav-link active" href="/rekap"><i class="bi bi-folder me-2"></i>Rekap Laporan</a>
        </nav>

        <!-- Statistik -->
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="stat-card stat-card-1">
                    <div class="stat-number"><%= laporanList.length %></div>
                    <div class="stat-label"><i class="bi bi-journal-text me-1"></i>Total Laporan</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card stat-card-2">
                    <% 
                        const today = new Date().toISOString().split('T')[0];
                        const todayReports = laporanList.filter(r => r.tanggalKey === today).length;
                    %>
                    <div class="stat-number"><%= todayReports %></div>
                    <div class="stat-label"><i class="bi bi-calendar-check me-1"></i>Laporan Hari Ini</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card stat-card-3">
                    <% 
                        const lastMonth = new Date();
                        lastMonth.setMonth(lastMonth.getMonth() - 1);
                        const lastMonthReports = laporanList.filter(r => new Date(r.tanggalKey) >= lastMonth).length;
                    %>
                    <div class="stat-number"><%= lastMonthReports %></div>
                    <div class="stat-label"><i class="bi bi-calendar-month me-1"></i>30 Hari Terakhir</div>
                </div>
            </div>
        </div>

        <!-- Daftar Laporan -->
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <i class="bi bi-clock-history me-2"></i>Riwayat Laporan
                </div>
                <div>
                    <a href="/" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-plus-circle me-1"></i>Buat Laporan Baru
                    </a>
                </div>
            </div>
            <div class="card-body">
                <% if (laporanList.length === 0) { %>
                <div class="text-center py-5">
                    <i class="bi bi-journal-x" style="font-size: 4rem; color: #dee2e6;"></i>
                    <h4 class="mt-3 text-muted">Belum ada laporan</h4>
                    <p class="text-muted">Mulai buat laporan harian Anda</p>
                    <a href="/" class="btn btn-primary mt-3">
                        <i class="bi bi-plus-circle me-2"></i>Buat Laporan Pertama
                    </a>
                </div>
                <% } else { %>
                    <% laporanList.forEach(laporan => { %>
                    <div class="laporan-card">
                        <div class="row align-items-center">
                            <div class="col-md-3">
                                <h5 class="mb-1"><%= laporan.tanggal %></h5>
                                <small class="text-muted">Kelas: <%= laporan.kelas %></small>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-1">
                                    <span class="badge bg-info me-2">
                                        <i class="bi bi-clock me-1"></i><%= laporan.jadwal?.length || 0 %> Jam
                                    </span>
                                    <span class="badge bg-success">
                                        <i class="bi bi-person-check me-1"></i>
                                        <% 
                                            const hadirCount = laporan.kehadiran?.filter(k => k.status === 'H').length || 0;
                                            const totalCount = laporan.kehadiran?.length || 0;
                                        %>
                                        <%= hadirCount %>/<%= totalCount %> Hadir
                                    </span>
                                </div>
                                <% if (laporan.kendala) { %>
                                <small class="text-truncate d-block" style="max-width: 300px;">
                                    <i class="bi bi-exclamation-triangle text-warning me-1"></i>
                                    <%= laporan.kendala.substring(0, 50) %>...
                                </small>
                                <% } %>
                            </div>
                            <div class="col-md-5 text-end">
                                <div class="btn-group btn-group-sm">
                                    <a href="/rekap/edit/<%= laporan.id %>" class="btn btn-edit">
                                        <i class="bi bi-pencil me-1"></i>Edit
                                    </a>
                                    <a href="/ekspor/<%= laporan.id %>" class="btn btn-ekspor">
                                        <i class="bi bi-download me-1"></i>Ekspor DOCX
                                    </a>
                                    <form action="/rekap/hapus/<%= laporan.id %>" method="POST" 
                                          style="display: inline;">
                                        <button type="submit" class="btn btn-hapus" 
                                                onclick="return confirm('Hapus laporan tanggal <%= laporan.tanggal %>?')">
                                            <i class="bi bi-trash me-1"></i>Hapus
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% }); %>
                <% } %>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>