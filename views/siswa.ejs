<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Data Kelas & Siswa - Laporan Harian Guru</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .header {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            color: white;
            padding: 2rem 0;
            margin-bottom: 2rem;
            border-radius: 0 0 20px 20px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        .card {
            border-radius: 15px;
            border: none;
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
            margin-bottom: 20px;
            transition: transform 0.3s;
        }
        .card:hover {
            transform: translateY(-5px);
        }
        .card-header {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            color: white;
            border-radius: 15px 15px 0 0 !important;
            padding: 1rem 1.5rem;
            font-weight: 600;
        }
        .btn-primary {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            border: none;
            padding: 10px 30px;
            border-radius: 25px;
            font-weight: 600;
        }
        .btn-primary:hover {
            background: linear-gradient(135deg, #3d9beb 0%, #00d9e6 100%);
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        }
        .nav-link {
            color: #495057;
            font-weight: 500;
            padding: 10px 20px;
            border-radius: 10px;
            margin: 0 5px;
        }
        .nav-link:hover, .nav-link.active {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            color: white;
        }
        .badge {
            padding: 8px 12px;
            border-radius: 20px;
            font-weight: 500;
        }
        .table th {
            background-color: #f8f9fa;
            font-weight: 600;
            color: #495057;
        }
        .kelas-card {
            border: 2px solid #e0e0e0;
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 20px;
            transition: all 0.3s;
            background: white;
        }
        .kelas-card:hover {
            border-color: #4facfe;
            box-shadow: 0 5px 15px rgba(79, 172, 254, 0.3);
        }
        .kelas-title {
            font-size: 1.3rem;
            font-weight: 700;
            color: #2c3e50;
            margin-bottom: 10px;
        }
        .kelas-info {
            color: #7f8c8d;
            font-size: 0.95rem;
        }
        .action-buttons {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }
    </style>
</head>
<body>
    <div class="header text-center">
        <div class="container">
            <h1><i class="bi bi-people me-2"></i>MANAJEMEN KELAS & SISWA</h1>
            <p class="lead">Kelola Data Kelas dan Siswa untuk Laporan Harian</p>
        </div>
    </div>

    <div class="container">
        <nav class="nav nav-pills justify-content-center mb-4">
            <a class="nav-link" href="/"><i class="bi bi-house-door me-2"></i>Form Laporan</a>
            <a class="nav-link active" href="/siswa"><i class="bi bi-people me-2"></i>Data Siswa</a>
            <a class="nav-link" href="/rekap"><i class="bi bi-folder me-2"></i>Rekap Laporan</a>
        </nav>

        <div class="row">
            <!-- Form Tambah Kelas -->
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <i class="bi bi-plus-circle me-2"></i>Tambah Kelas Baru
                    </div>
                    <div class="card-body">
                        <form action="/kelas/tambah" method="POST">
                            <div class="mb-3">
                                <label for="namaKelas" class="form-label">Nama Kelas <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="namaKelas" name="namaKelas" 
                                       placeholder="Contoh: XII TKJ 3" required>
                                <small class="text-muted">Masukkan nama kelas dengan lengkap</small>
                            </div>
                            <div class="mb-3">
                                <label for="mataPelajaran" class="form-label">Mata Pelajaran <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="mataPelajaran" name="mataPelajaran" 
                                       placeholder="Contoh: PKWU" required>
                                <small class="text-muted">Mata pelajaran yang diampu di kelas ini</small>
                            </div>
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-plus-circle me-2"></i>Tambah Kelas
                            </button>
                        </form>
                    </div>
                </div>

                <div class="card mt-4">
                    <div class="card-header">
                        <i class="bi bi-info-circle me-2"></i>Informasi
                    </div>
                    <div class="card-body">
                        <h6><i class="bi bi-lightbulb me-2"></i>Cara Menggunakan:</h6>
                        <ol class="small">
                            <li>Tambah kelas baru dengan mengisi form di atas</li>
                            <li>Klik "Lihat Detail" untuk mengelola siswa di kelas tersebut</li>
                            <li>Gunakan tombol Edit untuk mengubah nama kelas/mapel</li>
                            <li>Tombol Hapus akan menghapus kelas beserta semua siswanya</li>
                        </ol>
                        <div class="alert alert-warning mt-3 small">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            <strong>Perhatian:</strong> Menghapus kelas akan menghapus semua data siswa di kelas tersebut!
                        </div>
                    </div>
                </div>
            </div>

            <!-- Daftar Kelas -->
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div>
                            <i class="bi bi-list-ul me-2"></i>Daftar Kelas
                            <span class="badge bg-primary ms-2"><%= kelasList.length %> Kelas</span>
                        </div>
                    </div>
                    <div class="card-body">
                        <% if (kelasList.length === 0) { %>
                        <div class="text-center py-5">
                            <i class="bi bi-inbox" style="font-size: 4rem; color: #dee2e6;"></i>
                            <h4 class="mt-3 text-muted">Belum ada kelas</h4>
                            <p class="text-muted">Tambahkan kelas baru untuk memulai</p>
                        </div>
                        <% } else { %>
                            <% kelasList.forEach((kelas, index) => { %>
                            <div class="kelas-card">
                                <div class="row align-items-center">
                                    <div class="col-md-7">
                                        <div class="kelas-title">
                                            <i class="bi bi-bookmark-fill text-primary me-2"></i>
                                            <%= kelas.namaKelas %>
                                        </div>
                                        <div class="kelas-info">
                                            <i class="bi bi-book me-2"></i>Mata Pelajaran: <strong><%= kelas.mataPelajaran %></strong>
                                        </div>
                                        <div class="kelas-info mt-1">
                                            <i class="bi bi-people me-2"></i>Jumlah Siswa: <strong><%= kelas.jumlahSiswa || 0 %> siswa</strong>
                                        </div>
                                    </div>
                                    <div class="col-md-5">
                                        <div class="action-buttons">
                                            <a href="/siswa/kelas/<%= kelas.id %>" class="btn btn-primary btn-sm">
                                                <i class="bi bi-eye me-1"></i>Lihat Detail
                                            </a>
                                            <button class="btn btn-warning btn-sm" 
                                                    onclick="editKelas('<%= kelas.id %>', '<%= kelas.namaKelas %>', '<%= kelas.mataPelajaran %>')">
                                                <i class="bi bi-pencil me-1"></i>Edit
                                            </button>
                                            <form action="/kelas/hapus/<%= kelas.id %>" method="POST" style="display: inline;">
                                                <button type="submit" class="btn btn-danger btn-sm" 
                                                        onclick="return confirm('Hapus kelas <%= kelas.namaKelas %>? Semua siswa di kelas ini juga akan terhapus!')">
                                                    <i class="bi bi-trash me-1"></i>Hapus
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% }); %>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Edit Kelas -->
    <div class="modal fade" id="editKelasModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title"><i class="bi bi-pencil me-2"></i>Edit Kelas</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="editKelasForm" method="POST">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="editNamaKelas" class="form-label">Nama Kelas <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="editNamaKelas" name="namaKelas" required>
                        </div>
                        <div class="mb-3">
                            <label for="editMataPelajaran" class="form-label">Mata Pelajaran <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="editMataPelajaran" name="mataPelajaran" required>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-save me-2"></i>Simpan Perubahan
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function editKelas(id, namaKelas, mataPelajaran) {
            document.getElementById('editNamaKelas').value = namaKelas;
            document.getElementById('editMataPelajaran').value = mataPelajaran;
            document.getElementById('editKelasForm').action = '/kelas/edit/' + id;
            
            const modal = new bootstrap.Modal(document.getElementById('editKelasModal'));
            modal.show();
        }
    </script>
</body>
</html>