<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Form Laporan Harian Guru</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 2rem 0;
            margin-bottom: 2rem;
            border-radius: 0 0 20px 20px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        .card {
            border-radius: 15px;
            border: none;
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
            margin-bottom: 20px;
            transition: transform 0.3s;
        }
        .card:hover {
            transform: translateY(-5px);
        }
        .card-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 15px 15px 0 0 !important;
            padding: 1rem 1.5rem;
            font-weight: 600;
        }
        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            padding: 10px 30px;
            border-radius: 25px;
            font-weight: 600;
        }
        .btn-primary:hover {
            background: linear-gradient(135deg, #5a6fd8 0%, #6a4090 100%);
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        }
        .form-control, .form-select {
            border-radius: 10px;
            border: 2px solid #e0e0e0;
            padding: 10px 15px;
        }
        .form-control:focus, .form-select:focus {
            border-color: #764ba2;
            box-shadow: 0 0 0 0.25rem rgba(118, 75, 162, 0.25);
        }
        .table th {
            background-color: #f8f9fa;
            font-weight: 600;
            color: #495057;
        }
        .badge {
            padding: 8px 12px;
            border-radius: 20px;
            font-weight: 500;
        }
        .nav-link {
            color: #495057;
            font-weight: 500;
            padding: 10px 20px;
            border-radius: 10px;
            margin: 0 5px;
        }
        .nav-link:hover, .nav-link.active {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }
        .info-box {
            background: white;
            padding: 20px;
            border-radius: 15px;
            margin-bottom: 20px;
            border-left: 5px solid #667eea;
        }
        .jadwal-row {
            margin-bottom: 15px;
            padding: 15px;
            background: #f8f9fa;
            border-radius: 10px;
        }
    </style>
</head>
<body>
    <div class="header text-center">
        <div class="container">
            <h1><i class="bi bi-journal-text me-2"></i>LAPORAN HARIAN GURU</h1>
            <p class="lead">Sistem Pengelolaan Laporan Mengajar Harian</p>
        </div>
    </div>

    <div class="container">
        <nav class="nav nav-pills justify-content-center mb-4">
            <a class="nav-link active" href="/"><i class="bi bi-house-door me-2"></i>Form Laporan</a>
            <a class="nav-link" href="/siswa"><i class="bi bi-people me-2"></i>Data Siswa</a>
            <a class="nav-link" href="/rekap"><i class="bi bi-folder me-2"></i>Rekap Laporan</a>
        </nav>

        <div class="info-box">
            <h4>Informasi Guru</h4>
            <div class="row mt-3">
                <div class="col-md-3">
                    <strong>Sekolah:</strong><br>
                    <span class="text-muted"><%= sekolah %></span>
                </div>
                <div class="col-md-3">
                    <strong>Guru:</strong><br>
                    <span class="text-muted"><%= guru %></span>
                </div>
                <div class="col-md-3">
                    <strong>Mata Pelajaran:</strong><br>
                    <span class="text-muted"><%= mataPelajaran %></span>
                </div>
                <div class="col-md-3">
                    <strong>Hari/Tanggal:</strong><br>
                    <span class="text-muted"><%= tanggal %></span>
                </div>
            </div>
        </div>

        <form id="laporanForm" action="/simpan-laporan" method="POST">
            <input type="hidden" name="tanggal" value="<%= new Date().toISOString().split('T')[0] %>">
            <input type="hidden" name="tanggalDisplay" value="<%= tanggal %>">
            
            <!-- Bagian 1: Jadwal dan Materi -->
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-calendar3 me-2"></i>1. Jadwal dan Materi Pembelajaran
                </div>
                <div class="card-body">
                    <div id="jadwalContainer">
                        <div class="jadwal-row">
                            <div class="row g-3">
                                <div class="col-md-2">
                                    <label>Jam Ke</label>
                                    <input type="text" class="form-control" name="jamKe[]" placeholder="1-2">
                                </div>
                                <div class="col-md-2">
                                    <label>Kelas</label>
                                    <input type="text" class="form-control" value="<%= kelas %>" readonly>
                                </div>
                                <div class="col-md-3">
                                    <label>Materi / Topik</label>
                                    <input type="text" class="form-control" name="materi[]" placeholder="Materi pembelajaran">
                                </div>
                                <div class="col-md-2">
                                    <label>Metode</label>
                                    <input type="text" class="form-control" name="metode[]" placeholder="Metode">
                                </div>
                                <div class="col-md-2">
                                    <label>Media / Alat</label>
                                    <input type="text" class="form-control" name="media[]" placeholder="Media">
                                </div>
                                <div class="col-md-1">
                                    <label>Catatan</label>
                                    <input type="text" class="form-control" name="catatanJadwal[]" placeholder="Catatan">
                                </div>
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn btn-outline-primary btn-sm mt-2" onclick="tambahJadwal()">
                        <i class="bi bi-plus-circle"></i> Tambah Jam
                    </button>
                </div>
            </div>

            <!-- Bagian 2: Kehadiran Siswa -->
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-person-check me-2"></i>2. Kehadiran & Partisipasi Siswa
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th width="5%">No</th>
                                    <th width="30%">Nama Siswa</th>
                                    <th width="15%">Kehadiran (H/I/S)</th>
                                    <th width="20%">Partisipasi (Aktif/Pasif)</th>
                                    <th width="30%">Catatan</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% siswaList.forEach((siswa, index) => { %>
                                <tr>
                                    <td><%= index + 1 %></td>
                                    <td>
                                        <input type="hidden" name="siswaId[]" value="<%= siswa.id %>">
                                        <input type="hidden" name="siswaNama[]" value="<%= siswa.nama %>">
                                        <%= siswa.nama %>
                                    </td>
                                    <td>
                                        <select class="form-select" name="kehadiran[]">
                                            <option value="H" selected>H (Hadir)</option>
                                            <option value="I">I (Izin)</option>
                                            <option value="S">S (Sakit)</option>
                                        </select>
                                    </td>
                                    <td>
                                        <select class="form-select" name="partisipasi[]">
                                            <option value="Aktif" selected>Aktif</option>
                                            <option value="Pasif">Pasif</option>
                                        </select>
                                    </td>
                                    <td>
                                        <input type="text" class="form-control" name="catatanSiswa[]" placeholder="Catatan">
                                    </td>
                                </tr>
                                <% }); %>
                            </tbody>
                        </table>
                        <small class="text-muted">*Semua siswa otomatis Hadir dan Aktif. Ubah hanya untuk siswa yang berbeda.</small>
                    </div>
                </div>
            </div>

            <!-- Bagian 3: Kendala -->
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-exclamation-triangle me-2"></i>3. Kendala / Masalah dalam Pembelajaran
                </div>
                <div class="card-body">
                    <textarea class="form-control" name="kendala" rows="3" placeholder="Masukkan kendala atau masalah yang dihadapi..."></textarea>
                </div>
            </div>

            <!-- Bagian 4: Tindak Lanjut -->
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-arrow-repeat me-2"></i>4. Tindak Lanjut / Remedial / Pengayaan
                </div>
                <div class="card-body">
                    <div id="tindakLanjutContainer">
                        <div class="jadwal-row">
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label>Siswa / Kelompok</label>
                                    <input type="text" class="form-control" name="tlSiswa[]" placeholder="Nama siswa/kelompok">
                                </div>
                                <div class="col-md-3">
                                    <label>Jenis Tindak Lanjut</label>
                                    <select class="form-select" name="tlJenis[]">
                                        <option value="" selected>Pilih jenis...</option>
                                        <option value="Remedial">Remedial</option>
                                        <option value="Pengayaan">Pengayaan</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label>Waktu Pelaksanaan</label>
                                    <input type="text" class="form-control" name="tlWaktu[]" placeholder="Waktu pelaksanaan">
                                </div>
                                <div class="col-md-3">
                                    <label>Catatan Guru</label>
                                    <input type="text" class="form-control" name="tlCatatan[]" placeholder="Catatan guru">
                                </div>
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn btn-outline-primary btn-sm mt-2" onclick="tambahTindakLanjut()">
                        <i class="bi bi-plus-circle"></i> Tambah Tindak Lanjut
                    </button>
                </div>
            </div>

            <!-- Bagian 5: Catatan Tambahan -->
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-chat-text me-2"></i>5. Catatan Tambahan
                </div>
                <div class="card-body">
                    <textarea class="form-control" name="catatanTambahan" rows="3" placeholder="Masukkan catatan tambahan..."></textarea>
                </div>
            </div>

            <!-- Tombol Submit -->
                         <div class="text-center mt-4 mb-5">
                <button type="submit" class="btn btn-primary btn-lg me-3">
                    <i class="bi bi-save me-2"></i>Simpan Laporan
                </button>
                <a href="/" class="btn btn-outline-secondary btn-lg">
                    <i class="bi bi-arrow-clockwise me-2"></i>Reset Form
                </a>
            </div>
        </form>
    </div>

    <!-- Modal Success -->
    <div class="modal fade" id="successModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="bi bi-check-circle me-2"></i>Berhasil!</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                    <h4 class="mt-3">Laporan Berhasil Disimpan!</h4>
                    <p id="successMessage"></p>
                </div>
                <div class="modal-footer">
                    <a href="/rekap" class="btn btn-primary">
                        <i class="bi bi-folder me-2"></i>Lihat Rekap
                    </a>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Tutup</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Tambah baris jadwal
        function tambahJadwal() {
            const container = document.getElementById('jadwalContainer');
            const newRow = document.createElement('div');
            newRow.className = 'jadwal-row mt-3';
            newRow.innerHTML = `
                <div class="row g-3">
                    <div class="col-md-2">
                        <input type="text" class="form-control" name="jamKe[]" placeholder="1-2">
                    </div>
                    <div class="col-md-2">
                        <input type="text" class="form-control" value="<%= kelas %>" readonly>
                    </div>
                    <div class="col-md-3">
                        <input type="text" class="form-control" name="materi[]" placeholder="Materi pembelajaran">
                    </div>
                    <div class="col-md-2">
                        <input type="text" class="form-control" name="metode[]" placeholder="Metode">
                    </div>
                    <div class="col-md-2">
                        <input type="text" class="form-control" name="media[]" placeholder="Media">
                    </div>
                    <div class="col-md-1">
                        <input type="text" class="form-control" name="catatanJadwal[]" placeholder="Catatan">
                    </div>
                </div>
            `;
            container.appendChild(newRow);
        }

        // Tambah baris tindak lanjut
        function tambahTindakLanjut() {
            const container = document.getElementById('tindakLanjutContainer');
            const newRow = document.createElement('div');
            newRow.className = 'jadwal-row mt-3';
            newRow.innerHTML = `
                <div class="row g-3">
                    <div class="col-md-3">
                        <input type="text" class="form-control" name="tlSiswa[]" placeholder="Nama siswa/kelompok">
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" name="tlJenis[]">
                            <option value="" selected>Pilih jenis...</option>
                            <option value="Remedial">Remedial</option>
                            <option value="Pengayaan">Pengayaan</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <input type="text" class="form-control" name="tlWaktu[]" placeholder="Waktu pelaksanaan">
                    </div>
                    <div class="col-md-3">
                        <input type="text" class="form-control" name="tlCatatan[]" placeholder="Catatan guru">
                    </div>
                </div>
            `;
            container.appendChild(newRow);
        }

        // Handle form submission
        document.getElementById('laporanForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());
            
            // Convert array data
            const arrayFields = ['jamKe', 'materi', 'metode', 'media', 'catatanJadwal', 
                                'siswaId', 'siswaNama', 'kehadiran', 'partisipasi', 'catatanSiswa',
                                'tlSiswa', 'tlJenis', 'tlWaktu', 'tlCatatan'];
            
            const formDataObj = {};
            for (const [key, value] of formData.entries()) {
                if (arrayFields.includes(key.replace('[]', ''))) {
                    const cleanKey = key.replace('[]', '');
                    if (!formDataObj[cleanKey]) formDataObj[cleanKey] = [];
                    formDataObj[cleanKey].push(value);
                } else {
                    formDataObj[key] = value;
                }
            }
            
            try {
                const response = await fetch('/simpan-laporan', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(formDataObj)
                });
                
                const result = await response.json();
                
                if (result.success) {
                    document.getElementById('successMessage').textContent = 
                        `Laporan untuk tanggal ${formDataObj.tanggalDisplay} berhasil disimpan.`;
                    const modal = new bootstrap.Modal(document.getElementById('successModal'));
                    modal.show();
                } else {
                    alert('Error: ' + result.message);
                }
            } catch (error) {
                alert('Error: ' + error.message);
            }
        });
    </script>
</body>
</html>